            <form method="post" action="<?= e($assignment_url) ?>" class="d-inline"><?= csrf_field() ?><input type="hidden" name="operation" value="assign"><input type="hidden" name="qid" value="<?= e($candidate->qid) ?>"><button class="btn btn-sm btn-primary" type="submit"><?= I18N::translate('Assign') ?></button></form>
